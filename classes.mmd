classDiagram
  class CanBeShipped {
    calculate_shipping_cost()* float
  }
  class DigitalProduct {
    \_\_download_size : int
    display_information() None
    get_download_size() int
    get_fulfilment_info() str
  }
  class Inventory {
    \_\_products : list[Product]
    add_product(prod: Product) None
    display_all() None
    get_products() list[Product]
    search_inventory(prodId: int) None
    update_product_stock(newProdId: int, newStock: int) None
  }
  class PhysicalProduct {
    \_\_weight : int
    calculate_shipping_cost() float
    display_information() None
    get_fulfilment_info() str
    get_weight() int
  }
  class Product {
    \_\_name : str
    \_\_price : float
    \_\_product_id : int
    \_\_stock : int
    display_information() None
    get_fulfilment_info()* str
    get_name() str
    get_price() float
    get_product_id() int
    get_stock() int
    update_stock(new_quantity: int) None
  }
  DigitalProduct --|> Product
  PhysicalProduct --|> CanBeShipped
  PhysicalProduct --|> Product
  Product --o Inventory : \_\_products
